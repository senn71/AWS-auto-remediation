{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:DescribeSecurityGroups",
      "Resource": "*"
    },
    {
      "Sid": "RevokeOpenRules",
      "Effect": "Allow",
      "Action": "ec2:RevokeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:us-east-2:ACCOUNT_ID:security-group/*"
    },
    {
      "Sid": "SendAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-2:ACCOUNT_ID:SecurityAlerts"
    }
  ]
}
